    <string name="card_prompt_title">%1$s-இலிருந்து புதிய அட்டை</string>
    <string name="card_prompt_body">%1$s உங்கள் முகப்புத் திரையில் ஓர் அட்டையைக் காட்டலாம். மறைத்து வைத்தால் செயலியின் வழக்கமான டைல் அப்படியே இருக்கும்.</string>
